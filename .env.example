# Neo4j AuraDB
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# GitHub OAuth + Webhooks
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitLab OAuth + Webhooks
GITLAB_CLIENT_ID=your-gitlab-application-id
GITLAB_CLIENT_SECRET=your-gitlab-secret
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# Generic webhook
GENERIC_WEBHOOK_SECRET=your-generic-webhook-secret

# AI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=a-random-32-char-minimum-secret-here
NODE_ENV=development
